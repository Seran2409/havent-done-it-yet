  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "check:locales": "tsx scripts/check-locales.ts",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web && node -e \"require('fs').copyFileSync('dist/+not-found.html','dist/404.html')\"",
    "verify": "npm run check:locales && npm run typecheck && npm test",
    "serve:web": "node scripts/serve-dist.mjs",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "private": true
